{
    "name": "@cxe/data",
    "version": "0.4.8",
    "description": "aggregated datasets and utilities",
    "keywords": [
        "data",
        "airport",
        "airline",
        "country",
        "timezone",
        "language",
        "currency",
        "crime",
        "json",
        "yaml"
    ],
    "author": "Ian Carter <dev@cxe.io>",
    "license": "MIT",
    "private": false,
    "main": "index.js",
    "scripts": {
        "test": "bash -c \"NODE_OPTIONS='--experimental-vm-modules' npx jest $@\"",
        "test:coverage": "npm run test --coverage",
        "test:update": "npm run test -u",
        "release": "npm publish --access public"
    },
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cxe/data.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "bugs": {
        "url": "https://github.com/cxe/data/issues"
    },
    "jest": {
        "testMatch": [
            "**/tests/**/*.[jt]sx?",
            "**/tests/**/*.[mc]js"
        ],
        "coverageDirectory": "tmp/coverage",
        "testPathIgnorePatterns": [
            "<rootDir>/build/",
            "<rootDir>/node_modules/",
            "<rootDir>/tmp/"
        ]
    },
    "homepage": "https://github.com/cxe/data#readme",
    "exports": {
        ".": "./index.js",
        "./source/*": "./source/*.source.js",
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "jest": "30.0.4"
    },
    "dependencies": {
        "yaml": "2.8.0"
    }
}
